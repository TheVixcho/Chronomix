{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Chronomix (JUCE + Rust Release)",
            "type": "node-terminal",
            "request": "launch",
            "command": "${workspaceFolder}/build/chronomix_artefacts/Release/Chronomix",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cmake: build chronomix (release)",
            "env": {
                "RUST_LOG": "info"
            }
        },
        {
            "name": "Run Chronomix (JUCE + Rust Debug)",
            "type": "node-terminal",
            "request": "launch",
            "command": "${workspaceFolder}/build-debug/chronomix_artefacts/Debug/Chronomix",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cmake: build chronomix (debug)",
            "env": {
                "RUST_LOG": "info"
            }
        },
        {
            "name": "Debug Chronomix (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/chronomix_artefacts/Debug/Chronomix",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "RUST_LOG",
                    "value": "info"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "cmake: build chronomix (debug)"
        }
    ]
}
