{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Chronomix (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/chronomix",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cargo: build chronomix (debug)",
            "env": {
                "RUST_LOG": "info"
            }
        },
        {
            "name": "Debug Chronomix (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/chronomix",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "RUST_LOG",
                    "value": "info"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cargo: build chronomix (debug)"
        },
        {
            "name": "Run Chronomix (Release - CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/release/chronomix",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cargo: build chronomix (release)",
            "env": {
                "RUST_LOG": "info"
            }
        }
    ]
}
