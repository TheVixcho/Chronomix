{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "chronomix: check dependencies",
            "type": "shell",
            "linux": {
                "command": "bash",
                "args": [
                    "${workspaceFolder}/.vscode/check-deps.sh"
                ]
            },
            "osx": {
                "command": "sh",
                "args": [
                    "-c",
                    "command -v cargo >/dev/null 2>&1 && command -v rustc >/dev/null 2>&1 || { echo 'Cargo.toml:1: error: Falta Rust/Cargo (instala con https://rustup.rs)'; exit 1; }"
                ]
            },
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-Command",
                    "if (-not (Get-Command cargo -ErrorAction SilentlyContinue)) { Write-Output 'Cargo.toml:1: error: Falta Rust/Cargo (instala con https://rustup.rs)'; exit 1 }"
                ]
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": false,
                "showReuseMessage": false
            },
            "problemMatcher": {
                "owner": "chronomix-deps",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^([^:]+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "cargo: build chronomix (debug)",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--bin",
                "chronomix"
            ],
            "dependsOn": [
                "chronomix: check dependencies"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "cargo: build chronomix (release)",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--release",
                "--bin",
                "chronomix"
            ],
            "dependsOn": [
                "chronomix: check dependencies"
            ],
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "cargo: test workspace",
            "type": "shell",
            "command": "cargo",
            "args": [
                "test",
                "--workspace"
            ],
            "dependsOn": [
                "chronomix: check dependencies"
            ],
            "group": "test",
            "problemMatcher": [
                "$rustc"
            ]
        }
    ]
}
