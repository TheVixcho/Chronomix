{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "chronomix: check dependencies",
            "type": "shell",
            "linux": {
                "command": "bash",
                "args": [
                    "${workspaceFolder}/.vscode/check-deps.sh"
                ]
            },
            "osx": {
                "command": "sh",
                "args": [
                    "-c",
                    "command -v cargo >/dev/null 2>&1 && command -v cmake >/dev/null 2>&1 || { echo 'CMakeLists.txt:1: error: Faltan Rust/Cargo o CMake'; exit 1; }"
                ]
            },
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-Command",
                    "if (-not (Get-Command cargo -ErrorAction SilentlyContinue) -or -not (Get-Command cmake -ErrorAction SilentlyContinue)) { Write-Output 'CMakeLists.txt:1: error: Faltan Rust/Cargo o CMake'; exit 1 }"
                ]
            }
        },
        {
            "label": "cmake: build chronomix (release)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel"
            ],
            "dependsOn": [
                "chronomix: check dependencies"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "cmake: build chronomix (debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cmake -S . -B build-debug -G Ninja -DCMAKE_BUILD_TYPE=Debug && cmake --build build-debug --parallel"
            ],
            "dependsOn": [
                "chronomix: check dependencies"
            ],
            "group": "build"
        },
        {
            "label": "cargo: test workspace",
            "type": "shell",
            "command": "cargo",
            "args": [
                "test",
                "--workspace"
            ],
            "dependsOn": [
                "chronomix: check dependencies"
            ],
            "group": "test"
        },
        {
            "label": "chronomix: package release",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/build-release.sh"
            ],
            "dependsOn": [
                "chronomix: check dependencies"
            ],
            "group": "build"
        }
    ]
}
